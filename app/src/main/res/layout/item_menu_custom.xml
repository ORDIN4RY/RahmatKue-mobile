<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:backgroundTint="@color/cardview_light_background"
        android:paddingTop="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/productImg"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@drawable/logo"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSizeRounded" />

            <TextView
                android:id="@+id/productName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/productImg"
                android:text="Lemper"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/productSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mini"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:layout_toEndOf="@id/productName"
                android:paddingHorizontal="3dp"
                android:textAlignment="center"
                android:layout_alignTop="@id/productName"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/productPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/productName"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/productImg"
                android:text="Rp 75.000"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/product_varian"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mini"
                android:textSize="8sp"
                android:textColor="@color/card_light_bg"
                android:layout_toEndOf="@id/productName"
                android:paddingHorizontal="5dp"
                android:layout_marginStart="2dp"
                android:gravity="center"
                android:layout_alignTop="@id/productName"
                android:background="@drawable/bg_radius"
                android:backgroundTint="@android:color/holo_green_light"
                android:visibility="gone"
                />

            <TextView
                android:id="@+id/kapasitas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/productPrice"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/productImg"
                android:text="kapasitas: 4 item"
                android:textColor="@color/primary"
                />



            <TextView
                android:id="@+id/btn_pilih"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignBottom="@+id/productImg"
                android:layout_alignParentEnd="true"
                android:background="@drawable/btn_filter_produk"
                android:textColor="@drawable/btn_filter_produk"
                android:paddingHorizontal="20dp"
                android:paddingVertical="7dp"
                android:gravity="center"
                android:text="Pilih"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/counter_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_outline"
                android:gravity="center"
                android:padding="5dp"
                android:visibility="gone"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@+id/productImg">

                <ImageView
                    android:id="@+id/icon_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/circle_outline"
                    android:src="@drawable/icon_minus" />

                <EditText
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:id="@+id/input_count"
                    android:layout_width="50dp"
                    android:layout_height="24dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_counter"
                    android:text="15"
                    android:textAlignment="center"
                    android:textSize="16sp"
                    android:paddingHorizontal="5dp"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:inputType="number"
                    />

                <ImageView
                    android:id="@+id/icon_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/circle_outline"
                    android:src="@drawable/icon_plus" />

            </LinearLayout>


        </RelativeLayout>


    </androidx.cardview.widget.CardView>


</RelativeLayout>