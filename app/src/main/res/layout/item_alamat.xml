<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:backgroundTint="@color/card_light_bg">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <TextView
            android:id="@+id/nama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Ahmad Syahroni |"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nomor_telepon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:layout_toRightOf="@id/nama"
            android:text="08531413721"
            android:textSize="12sp"
            android:textColor="@color/primary"/>

        <TextView
            android:id="@+id/alamat_lengkap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/nama"
            android:layout_marginStart="12dp"
            android:text="Jl. Ahmad Yani 20, Tanggul Kulon (Sebelah Alfamart )"
            android:textColor="@color/primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/ubah_alamat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Ubah > "
            android:textSize="12sp" />

        <TextView
            android:id="@+id/alamat_utama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/alamat_lengkap"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="5dp"
            android:text="Alamat Utama"
            android:textSize="10sp"
            android:visibility="invisible"/>
    </RelativeLayout>

</androidx.cardview.widget.CardView>


