<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/voucher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="15dp"
            app:cardBackgroundColor="@color/background">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp">


                <ImageView
                    android:id="@+id/back"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/back" />

                <TextView
                    style="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/back"
                    android:text="Voucher "
                    android:textColor="@color/primary" />


                <TextView
                    android:id="@+id/user_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_points"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="0 Points"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </RelativeLayout>
            <!-- Tambahkan ProgressBar di layout activity_voucher.xml -->
            <ProgressBar
                android:id="@+id/loadingProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:hint="Cari voucher..."
        android:textSize="10sp"
        android:layout_gravity="center"
        android:padding="10dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/input_rounded"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp">

        <TextView
            android:id="@+id/btnVoucherSaya"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_filter_produk"
            android:padding="10dp"
            android:text="Voucher Saya"
            android:gravity="center"
            android:textColor="@drawable/btn_filter_produk" />

        <TextView
            android:id="@+id/btnTukarVoucher"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnVoucherSaya"
            android:background="@drawable/btn_filter_produk"
            android:padding="10dp"
            android:text="Tukar Voucher"
            android:gravity="center"
            android:textColor="@drawable/btn_filter_produk" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvVoucher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp" />


</LinearLayout>