<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/voucher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Voucher"
    android:background="@color/background"
    android:orientation="vertical"
    >
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:elevation="10dp"/>

        <ImageView
            android:id="@+id/back"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            android:src="@drawable/back"
            />

        <TextView
            android:layout_marginLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voucher "
            android:layout_marginTop="10dp"
            android:textColor="@color/primary"
            style="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
            android:layout_toEndOf="@id/back"
            />

    <androidx.cardview.widget.CardView
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:layout_below="@id/top"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="15dp"
        >

        <TextView
            android:id="@+id/total_voucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Poin Saya"
            android:textSize="15dp"
            android:layout_gravity="center_horizontal"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Poin"
            android:textSize="30dp"
            android:layout_gravity="center"
            />
    </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnTukarVoucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:text="Tukar Voucher"
            android:textStyle="bold"
            android:background="@drawable/border_tab"
            android:textColor="@android:color/black"
            android:layout_below="@id/top"
            android:padding="10dp"/>

        <Button
            android:id="@+id/btnVoucherSaya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:text="Voucher Saya"
            android:layout_below="@id/top"
            android:layout_toRightOf="@id/btnTukarVoucher"
            android:background="@drawable/border_tab"
            android:textColor="@android:color/black"
            android:padding="10dp"/>
    </RelativeLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">

        <View
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:background="@color/black"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voucher Saya"
            android:textSize="20dp"
            android:layout_marginTop="10dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:paddingHorizontal="10dp"/>
    </FrameLayout>

</LinearLayout>