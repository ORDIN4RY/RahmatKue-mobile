<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/voucher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".Voucher">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="15dp"
            app:cardBackgroundColor="@color/background">

            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:elevation="10dp" />

            <ImageView
                android:id="@+id/back"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:src="@drawable/back" />

            <TextView
                style="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="35dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:text="Voucher "
                android:textColor="@color/primary" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/total_poin"
            android:layout_width="120dp"
            android:layout_height="70dp"
            android:layout_below="@id/top"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="15dp">

            <TextView
                android:id="@+id/total_voucher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Total Poin Saya"
                android:textSize="15dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0 Poin"
                android:textSize="30dp" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnTukarVoucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/top"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/border_tab"
            android:padding="10dp"
            android:text="Tukar Voucher"
            android:textColor="@android:color/black"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVoucherSaya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/top"
            android:layout_marginTop="10dp"
            android:layout_toRightOf="@id/btnTukarVoucher"
            android:layout_weight="1"
            android:background="@drawable/border_tab"
            android:padding="10dp"
            android:text="Voucher Saya"
            android:textColor="@android:color/black" />

        <EditText
            android:layout_width="150dp"
            android:layout_height="35dp"
            android:layout_below="@id/total_poin"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_text"
            android:hint="Reedem Code"
            android:textColor="@color/primary"
            android:textSize="12sp" />
    </RelativeLayout>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <View
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:background="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Voucher Saya"
            android:textSize="20dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="50dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

    </FrameLayout>

</LinearLayout>