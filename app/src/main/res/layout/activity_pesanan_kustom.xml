<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="15dp"
    tools:context=".pelanggan.activity.PesananKustom">

    <ImageView
        android:id="@+id/back"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@android:color/transparent"
        android:src="@drawable/back" />

    <TextView
        android:id="@+id/header"
        style="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_toEndOf="@id/back"
        android:text="Pesanan Kustom"
        android:textColor="@color/primary" />

    <ImageView
        android:id="@+id/icon_notif"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="10dp"
        android:background="@android:color/transparent"
        android:src="@drawable/notif" />

    <ImageView
        android:id="@+id/gambar_produk"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_below="@id/header"
        android:layout_marginTop="25dp"
        android:background="@drawable/logo" />

    <TextView
        android:id="@+id/nama_produk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:layout_marginTop="20dp"
        android:layout_toRightOf="@id/gambar_produk"
        android:text="Kotak Medium"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/deskripsi_produk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/nama_produk"
        android:layout_toRightOf="@id/gambar_produk"
        android:text="Kotak dengan ukuran 18*18*7.5 cm dengan perkiraan isi 7 kue"
        android:textSize="10sp" />

    <CheckBox
        android:id="@+id/checkbox1"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_below="@id/deskripsi_produk"
        android:layout_marginTop="10dp"
        android:layout_toRightOf="@id/gambar_produk"
        android:text="Tambah Aqua?" />

    <ImageView
        android:id="@+id/icon_minus"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_below="@id/deskripsi_produk"
        android:layout_marginTop="20dp"
        android:layout_toLeftOf="@id/input_count"
        android:background="@drawable/circle_outline"
        android:src="@drawable/icon_minus"

        />

    <EditText
        android:id="@+id/input_count"
        android:layout_width="40dp"
        android:layout_height="20dp"
        android:layout_below="@id/deskripsi_produk"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="19dp"
        android:layout_marginRight="5dp"
        android:layout_toLeftOf="@id/icon_plus"
        android:background="@drawable/bg_counter"
        android:inputType="number"
        android:paddingHorizontal="5dp"
        android:text="8"
        android:textAlignment="center"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/icon_plus"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_below="@id/deskripsi_produk"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:background="@drawable/circle_outline"
        android:src="@drawable/icon_plus" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/input_count"
        android:layout_alignParentEnd="true"
        android:text="nb: minimal pemesanan 10 kotak"
        android:textSize="8sp" />

    <View
        android:id="@+id/garis_pembatas"
        android:layout_width="wrap_content"
        android:layout_height="1dp"
        android:layout_below="@id/input_count"
        android:layout_marginTop="15dp"
        android:background="@color/black" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_daftar_produk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/garis_pembatas"
        android:layout_marginTop="15dp"
        android:elevation="8dp"
        app:cardCornerRadius="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rec_view_kustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/rec_view_kustom"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="100dp"
                android:text="Total Pesanan : " />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/rec_view_kustom"
                android:layout_alignParentEnd="true"
                android:text="Rp. 150.000" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Catatan untuk Toko"
        android:layout_below="@id/card_daftar_produk"
        android:layout_marginTop="10dp"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_below="@id/card_daftar_produk"
        android:layout_marginTop="37dp"
        android:background="@drawable/bg_input_text"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opsional"
        android:textSize="5sp"
        android:layout_below="@id/card_daftar_produk"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="10sp"
        android:background="@drawable/bg_input_text"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/btn_outline"
        android:text="Tambahkan Keranjang"
        />
</RelativeLayout>