<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".pelanggan.PengaturanFragment"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        >

        <TextView
            android:layout_marginLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan"
            android:textColor="@color/primary"
            style="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
            />

        <ImageView
            android:id="@+id/icon_cart"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@drawable/cart"
            android:layout_marginRight="20dp"
            android:layout_toLeftOf="@id/icon_notif"
            />

        <ImageView
            android:id="@+id/icon_notif"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@drawable/notif"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="10dp"
            />

    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/white"
        android:backgroundTint="@color/white"
        android:layout_margin="20dp"
        app:cardCornerRadius="20dp"
        android:elevation="5dp"
        >
        <RelativeLayout
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/img_profil"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginLeft="10dp"
                android:background="@drawable/circle_background"
                android:clipToOutline="true"
                android:padding="10dp"
                android:src="@drawable/profil" />

            <TextView
                android:layout_marginLeft="20dp"
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ahmad Hananto"
                android:layout_toRightOf="@id/img_profil"
                style="@style/TextAppearance.AppCompat.Title"
                android:textColor="@color/primary"
            />
            <TextView
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08123332233"
                android:layout_below="@id/username"
                android:layout_toRightOf="@id/img_profil"
                style="@style/TextAppearance.AppCompat.Small"
                android:textColor="@color/primary"
            />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/pencil"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"/>

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="3dp"
        android:layout_marginHorizontal="20dp"
        app:cardCornerRadius="20dp"
        >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_light_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="20dp"
        >
        <TextView
            android:elevation="3dp"
            style="@style/TextAppearance.Material3.ActionBar.Subtitle"
            android:textColor="@color/primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voucher Dimiliki"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/outline_btn"/>
        <TextView
            android:elevation="3dp"
            style="@style/TextAppearance.Material3.ActionBar.Subtitle"
            android:textColor="@color/primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alamat Tersimpan"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/outline_btn"/>
        <TextView
            android:elevation="3dp"
            style="@style/TextAppearance.Material3.ActionBar.Subtitle"
            android:textColor="@color/primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pengaturan Aplikasi"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/outline_btn"/>
        <TextView
            android:elevation="3dp"
            style="@style/TextAppearance.Material3.ActionBar.Subtitle"
            android:textColor="@color/primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bantuan"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/outline_btn"/>
        <TextView
            android:id="@+id/logout"
            android:elevation="3dp"
            style="@style/TextAppearance.Material3.ActionBar.Subtitle"
            android:textColor="@color/primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:paddingHorizontal="20dp"
            android:paddingVertical="20dp"
            android:background="@drawable/outline_btn"/>
    </LinearLayout>

    </ScrollView>

    </androidx.cardview.widget.CardView>



</LinearLayout>