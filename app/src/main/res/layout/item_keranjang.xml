<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardProduct1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/cardview_light_background"
        android:paddingTop="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_margin="5dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_product"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@drawable/logo"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSizeRounded" />



            <TextView
                android:textColor="@color/primary"
                android:id="@+id/nama_produk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KUE AMD"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_toEndOf="@+id/img_product"
                android:layout_marginStart="5dp"/>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/img_product"
                android:layout_alignBottom="@+id/img_product"
                android:layout_marginTop="10dp"
                android:layout_marginStart="5dp"
                >
                <TextView
                    android:textColor="@color/primary"
                    android:id="@+id/btnMinus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="-"
                    android:textSize="24sp"/>

                <!-- Angka -->
                <TextView
                    android:textColor="@color/primary"
                    android:id="@+id/txtCount"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@id/btnMinus"
                    android:background="@drawable/bg_counter"
                    android:gravity="center"
                    android:text="15"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_centerVertical="true"/>

                <!-- Tombol Plus -->
                <TextView
                    android:textColor="@color/primary"
                    android:id="@+id/btnPlus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_toRightOf="@id/txtCount"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="+"
                    android:textSize="24sp" />

            </RelativeLayout>


            <TextView
                android:textColor="@color/primary"
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/img_product"
                android:layout_alignParentEnd="true"
                android:text="Rp. 200.000" />

            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
