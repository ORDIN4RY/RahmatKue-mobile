<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardProduct1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/cardview_light_background"
        android:paddingTop="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="5dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_product"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@drawable/logo"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSizeRounded" />



            <TextView
                android:textColor="@color/primary"
                android:id="@+id/nama_produk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KUE AMD"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_toEndOf="@+id/img_product"
                android:layout_marginStart="10dp"/>

            <LinearLayout
                android:id="@+id/counter_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="5dp"
                android:layout_toEndOf="@id/img_product"
                android:layout_alignBottom="@+id/img_product">

                <ImageView
                    android:id="@+id/icon_minus"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/circle_outline"
                    android:src="@drawable/icon_minus" />

                <EditText
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:id="@+id/input_count"
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@drawable/bg_counter"
                    android:text="8"
                    android:textAlignment="center"
                    android:textSize="16sp"
                    android:paddingHorizontal="5dp"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:inputType="number"
                    />

                <ImageView
                    android:id="@+id/icon_plus"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@drawable/circle_outline"
                    android:src="@drawable/icon_plus" />

            </LinearLayout>

            <TextView
                android:textColor="@color/primary"
                android:id="@+id/txt_harga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@+id/img_product"
                android:layout_alignParentEnd="true"
                android:text="Rp. 200.000" />

            <CheckBox
                android:id="@+id/cb_pilih"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
