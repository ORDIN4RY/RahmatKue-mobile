<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".BerandaFragment"
    android:orientation="vertical">
<!--    android:padding="10dp"-->

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        >

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/profil"
        android:padding="10dp"
        android:background="@drawable/circle_background"
        android:clipToOutline="true"
        android:layout_marginRight="10dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hai Mamad!"
        android:textColor="@color/primary"
        style="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
        />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:orientation="vertical"
            android:gravity="center_horizontal"
        >
        <TextView
            android:gravity="center"
            android:background="@color/primary"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:text="anggep aja carousel"
            android:textAlignment="center"
            android:textColor="@color/background"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="o  o  o  o  o  o"
            style="@style/TextAppearance.Material3.HeadlineSmall"
            android:textStyle="bold"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:paddingHorizontal="20dp"
        >

        <com.google.android.material.button.MaterialButton
            android:layout_width="144dp"
            android:layout_height="wrap_content"
            android:text="Delivery"
            app:icon="@drawable/delivery"
            android:textColor="@color/background"
            android:iconTint="@color/background"
            app:cornerRadius="50dp"
            app:strokeWidth="0dp"
            android:layout_marginRight="30dp"
        />
        <com.google.android.material.button.MaterialButton
            android:layout_width="144dp"
            android:layout_height="wrap_content"
            android:text="Take Away"
            app:icon="@drawable/takeaway"
            android:textColor="@color/background"
            android:iconTint="@color/background"
            app:cornerRadius="50dp"
            app:strokeWidth="0dp"
            />

    </LinearLayout>

    



</LinearLayout>