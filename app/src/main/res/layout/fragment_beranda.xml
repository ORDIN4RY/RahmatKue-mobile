<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".pelanggan.fragment.BerandaFragment">
    <!--    android:padding="10dp"-->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp">

                <ImageView
                    android:id="@+id/img_profil"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/circle_background"
                    android:clipToOutline="true"
                    android:padding="10dp"
                    android:src="@drawable/profil" />

                <TextView
                    android:id="@+id/nickname"
                    style="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/img_profil"
                    android:text="Hai Mamad!"
                    android:textColor="@color/primary" />

                <TextView
                    android:id="@+id/user_point"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_points"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="0 Points"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </RelativeLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
               >
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/carousel_view_pager"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                style="@style/TextAppearance.AppCompat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:text="Pesanan Terakhir > "
                android:textColor="@color/primary" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPesananTerakhir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

            </ScrollView>
<RelativeLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_gravity="center">
            <TextView
                android:id="@+id/txt_promo"
                style="@style/TextAppearance.AppCompat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:text="Promo Terbaru > "
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/promo"
                android:layout_below="@id/txt_promo"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginHorizontal="15dp"
                android:background="@color/primary"
                android:gravity="center"
                android:text="promo"
                android:textAlignment="center"
                android:textColor="@color/background" />

            <TextView
                android:id="@+id/txt_menu_terbaru"
                style="@style/TextAppearance.AppCompat.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:layout_marginTop="10dp"
                android:text="Menu Terbaru > "
                android:layout_toRightOf="@id/txt_promo"
                android:textColor="@color/primary" />

            <TextView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginHorizontal="15dp"
                android:background="@color/primary"
                android:gravity="center"
                android:layout_below="@id/txt_menu_terbaru"
                android:layout_toRightOf="@id/promo"
                android:text="menu"

                android:textAlignment="center"
                android:textColor="@color/background" />
</RelativeLayout>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>
