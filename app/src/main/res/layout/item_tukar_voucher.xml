<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="10sp"
    app:cardCornerRadius="10dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/gambar_voucher"
            android:layout_width="200dp"
            android:layout_height="75dp"
            android:background="@drawable/profil"
            />

        <TextView
            android:id="@+id/nama_voucher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ramadhan 2026 - Diskon 20k"
            android:layout_below="@id/gambar_voucher"
            android:textSize="15dp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/poin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50 Poin"
            android:layout_below="@id/nama_voucher"
            android:layout_marginTop="50dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">"
            android:textSize="20dp"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/nama_voucher"
            android:layout_marginTop="50dp"
            android:layout_marginStart="125dp"

            />



    </RelativeLayout>
</androidx.cardview.widget.CardView>