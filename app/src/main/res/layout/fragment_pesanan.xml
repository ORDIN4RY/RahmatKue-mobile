<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pelanggan.fragment.PesananFragment"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
    <!-- buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:padding="10dp">

        <TextView
            android:id="@+id/btn_semua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/SearchBar"
            android:text="Semua"
            android:textColor="@color/primary"
            android:background="@drawable/btn_outline"
            android:textSize="16sp"
            android:layout_marginHorizontal="10dp"
            android:textAlignment="center"
            />

        <TextView
            android:id="@+id/btn_blm_dibayar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/SearchBar"
            android:text="Belum Dibayar"
            android:textColor="@color/white"
            android:background="@drawable/btn_full"
            android:layout_toRightOf="@id/btn_semua"
            android:textSize="16sp"
            android:layout_marginHorizontal="10dp"
            android:textAlignment="center"
            />
        <TextView
            android:id="@+id/btn_proses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/SearchBar"
            android:text="Proses"
            android:textColor="@color/white"
            android:background="@drawable/btn_full"
            android:layout_toRightOf="@id/btn_semua"
            android:textSize="16sp"
            android:layout_marginHorizontal="10dp"
            android:textAlignment="center"
            />

        <TextView
            android:id="@+id/btn_selesai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/SearchBar"
            android:text="Selesai"
            android:textColor="@color/white"
            android:background="@drawable/btn_full"
            android:layout_toRightOf="@id/btn_proses"
            android:textSize="16sp"
            android:layout_marginHorizontal="10dp"
            android:textAlignment="center"
            />

    </LinearLayout>
    </HorizontalScrollView>

    <!--    pesanan    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:orientation="vertical">

<!--        card pesanan        -->
        <androidx.cardview.widget.CardView
        android:id="@+id/pesanan1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/cardview_light_background"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp"
        android:layout_marginBottom="10dp">

        <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/imgProduct1"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo"
            android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/namakue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/imgProduct1"
                android:layout_marginStart="10dp"
                android:text="KUE A"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="KUE gggg"/>

            <TextView
                android:id="@+id/itemtambahan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/imgProduct1"
                android:layout_marginStart="10dp"
                android:textSize="8sp"
                android:layout_below="@id/namakue"
                android:text="Item Tambahan :"/>

            <TextView
                android:id="@+id/statuspembayaran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/imgProduct1"
                android:layout_marginTop="10dp"
                android:text="Lunas"/>

            <TextView
                android:id="@+id/totalpesanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/statuspembayaran"
                android:layout_marginStart="10dp"
                android:gravity="right"
                android:text="Total Pesanan :Rp.200.000"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@id/totalpesanan"
                android:text="X1"
                android:gravity="right"/>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    </LinearLayout>

    </ScrollView>

</LinearLayout>