<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pelanggan.PesananFragment"
    android:orientation="vertical">


    <!-- Judul Fragment -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        >

        <TextView
            android:layout_marginLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar Pesanan"
            android:textColor="@color/primary"
            style="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
            />

        <ImageView
            android:id="@+id/icon_cart"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@drawable/cart"
            android:layout_marginRight="20dp"
            android:layout_toLeftOf="@id/icon_notif"
            />

        <ImageView
            android:id="@+id/icon_notif"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@drawable/notif"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="10dp"
            />

    </RelativeLayout>


    <!-- buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:padding="10dp">
        <Button
            android:id="@+id/btnAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/SearchBar"
            android:text="Semua"
            android:background="@drawable/button"
            android:layout_marginHorizontal="10dp"/>

        <Button
            android:id="@+id/btnProses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/SearchBar"
            android:text="Proses"
            android:background="@drawable/button"
            android:layout_toRightOf="@id/btnAll"
            android:layout_marginHorizontal="10dp"/>

        <Button
            android:id="@+id/btnSelesai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/SearchBar"
            android:text="Selesai"
            android:background="@drawable/button"
            android:layout_toRightOf="@id/btnPromo"
            android:layout_marginHorizontal="10dp"/>
    </LinearLayout>

    <!--    pesanan    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:orientation="vertical">

<!--        card pesanan        -->
        <androidx.cardview.widget.CardView
        android:id="@+id/pesanan1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/cardview_light_background"
        app:cardElevation="4dp"
        app:cardCornerRadius="12dp"
        android:layout_marginBottom="10dp">

        <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/imgProduct1"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo"
            android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/namakue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/imgProduct1"
                android:layout_marginStart="10dp"
                android:text="KUE A"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:text="KUE gggg"/>

            <TextView
                android:id="@+id/itemtambahan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/imgProduct1"
                android:layout_marginStart="10dp"
                android:textSize="8sp"
                android:layout_below="@id/namakue"
                android:text="Item Tambahan :"/>

            <TextView
                android:id="@+id/statuspembayaran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/imgProduct1"
                android:layout_marginTop="10dp"
                android:text="Lunas"/>

            <TextView
                android:id="@+id/totalpesanan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/statuspembayaran"
                android:layout_marginStart="10dp"
                android:gravity="right"
                android:text="Total Pesanan :Rp.200.000"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@id/totalpesanan"
                android:text="X1"
                android:gravity="right"/>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    </LinearLayout>

    </ScrollView>

</LinearLayout>