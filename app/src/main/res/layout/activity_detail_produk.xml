<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="16dp">


    <ImageView
        android:id="@+id/btn_back_detail"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:contentDescription="Back"
        android:src="@drawable/back" />


    <ImageView
        android:id="@+id/img_detail"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_below="@id/btn_back_detail"
        android:scaleType="centerCrop" />


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/img_detail">

        <TextView
            android:id="@+id/txt_nama_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nama Produk"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_harga_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:text="Rp. 100000"
            android:textSize="18sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/txt_deskripsi_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_harga_detail"
            android:layout_marginTop="4dp"
            android:text="deskripsi produk"
            android:textSize="14sp" />

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_deskripsi_detail">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_detail_paket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="5dp" />

        </ScrollView>

        <LinearLayout
            android:id="@+id/counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/scrollView">

            <ImageView
                android:id="@+id/icon_minus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="100dp"
                android:background="@drawable/circle_outline"
                android:src="@drawable/icon_minus" />

            <EditText
                android:id="@+id/input_count"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_counter"
                android:gravity="center"
                android:inputType="number"
                android:paddingHorizontal="5dp"
                android:textAlignment="center"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="0"/>

            <ImageView
                android:id="@+id/icon_plus"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/circle_outline"
                android:src="@drawable/icon_plus" />

        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_add_keranjang"
            android:layout_width="0dp"
           android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:background="@drawable/btn_outline"
            android:text="Keranjang"
            android:textAlignment="center"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_check_out"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:textStyle="bold"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_filter_produk"
            android:text="Checkout"
            android:textAlignment="center"
            android:textColor="@drawable/btn_filter_produk"
            android:textSize="14sp"
            />
    </LinearLayout>


</RelativeLayout>

