<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="16dp">


    <ImageView
        android:id="@+id/btn_back_detail"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="Back"
        android:src="@drawable/back" />


    <ImageView
        android:id="@+id/img_detail"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop" />

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txt_nama_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kue Kucur"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_harga_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginTop="8dp"
            android:text="Rp. 100000"
            android:textSize="18sp"
            android:textStyle="bold" />


    <TextView
        android:id="@+id/txt_deskripsi_detail"
        android:layout_width="match_parent"
        android:layout_below="@id/txt_harga_detail"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_detail_paket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="5dp"
        android:layout_below="@id/txt_deskripsi_detail"/>


        <ImageView
            android:id="@+id/icon_minus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/circle_outline"
            android:src="@drawable/icon_minus"
            android:layout_marginStart="100dp"
            android:layout_below="@id/rv_detail_paket"/>

        <EditText
            android:id="@+id/input_count"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_counter"
            android:gravity="center"
            android:inputType="number"
            android:paddingHorizontal="5dp"
            android:text="8"
            android:layout_below="@id/rv_detail_paket"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:layout_centerInParent="true"
           android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/icon_plus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_below="@id/rv_detail_paket"
            android:background="@drawable/circle_outline"
            android:src="@drawable/icon_plus"
            android:layout_marginStart="130dp"
            android:layout_toRightOf="@id/input_count"/>
    </RelativeLayout>
    </ScrollView>


</LinearLayout>

