<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/btn_back_detail"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_margin="8dp"
        android:padding="8dp"
        android:src="@drawable/back"
        android:elevation="4dp" />

    <!-- Image Container with Badge -->
    <RelativeLayout
        android:id="@+id/img_container"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_below="@id/btn_back_detail">

        <ImageView
            android:id="@+id/img_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder" />

        <!-- Badge Diskon -->
        <TextView
            android:id="@+id/badge_diskon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="16dp"
            android:background="@drawable/badge_diskon"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="-20%"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:elevation="4dp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/counter"
        android:layout_below="@id/img_container">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:padding="16dp">

            <TextView
                android:id="@+id/txt_nama_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Nama Produk"
                android:textColor="#212121"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Price Container -->
            <LinearLayout
                android:id="@+id/price_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txt_nama_detail"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <!-- Harga Asli (dicoret jika diskon) -->
                <TextView
                    android:id="@+id/txt_harga_asli"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 100.000"
                    android:textColor="#999999"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Harga Final -->
                <TextView
                    android:id="@+id/txt_harga_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#E8F5E9"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Rp 80.000"
                    android:textColor="#4CAF50"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Info Hemat -->
                <TextView
                    android:id="@+id/txt_hemat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hemat Rp 20.000"
                    android:textColor="@color/status_aktif"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_deskripsi_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/price_container"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="deskripsi produk"
                android:textColor="#616161"
                android:textSize="14sp" />

            <!-- Detail Paket (if paket) -->
            <TextView
                android:id="@+id/title_isi_paket"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txt_deskripsi_detail"
                android:layout_marginTop="16dp"
                android:text="Isi Paket"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_detail_paket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/title_isi_paket"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />
        </RelativeLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/counter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/txt_total_harga"
        android:layout_marginBottom="16dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/icon_minus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/circle_outline"
            android:src="@drawable/icon_minus" />

        <EditText
            android:id="@+id/input_count"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="18dp"
            android:background="@drawable/bg_counter"
            android:gravity="center"
            android:inputType="number"
            android:paddingHorizontal="5dp"
            android:text="1"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/icon_plus"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/circle_outline"
            android:src="@drawable/icon_plus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/txt_total_harga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btn_container"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Total:"
            android:textColor="#666666"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txt_total_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btn_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/btn_add_keranjang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_filter_produk_outline"
            android:gravity="center"
            android:padding="16dp"
            android:text="+ Keranjang"
            android:textAlignment="center"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_check_out"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_filter_produk"
            android:gravity="center"
            android:padding="16dp"
            android:text="Checkout"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>