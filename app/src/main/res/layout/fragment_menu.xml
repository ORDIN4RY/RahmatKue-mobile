    <!-- Judul Fragment -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        >

        <TextView
            android:layout_marginLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu Produk"
            android:textColor="@color/primary"
            style="@style/TextAppearance.Material3.HeadlineSmall.Emphasized"
            />

        <ImageView
            android:id="@+id/icon_cart"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@drawable/cart"
            android:layout_marginRight="20dp"
            android:layout_toLeftOf="@id/icon_notif"
            />

        <ImageView
            android:id="@+id/icon_notif"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@drawable/notif"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="10dp"
            />

    </RelativeLayout>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/SearchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:hint="Cari produk..."
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="6dp"
        android:background ="@drawable/input_rounded"
        android:layout_marginHorizontal="10dp"/>

    <!-- buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:padding="10dp">
        <Button
            android:id="@+id/btnAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/SearchBar"
            android:text="Semua"
            android:background="@drawable/button"
            android:layout_marginHorizontal="10dp"/>

        <Button
            android:id="@+id/btnPromo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/SearchBar"
            android:text="Promo"
            android:background="@drawable/button"
            android:layout_toRightOf="@id/btnAll"
            android:layout_marginHorizontal="10dp"/>

        <Button
            android:id="@+id/btnPaket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/SearchBar"
            android:text="Paket"
            android:background="@drawable/button"
            android:layout_toRightOf="@id/btnPromo"
            android:layout_marginHorizontal="10dp"/>
    </LinearLayout>

