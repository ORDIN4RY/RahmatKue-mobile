<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ✅ SAAT DITEKAN -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/coklatSikit"/> <!-- warna lebih gelap -->
            <corners android:radius="10dp" />
            <padding
                android:top="5dp"
                android:bottom="5dp" />
            <stroke
                android:color="@color/coklatSikit"
                android:width="1dp" />
        </shape>
    </item>

    <!-- ✅ SAAT NORMAL -->
    <item>
        <shape>
            <solid android:color="@color/primary"/> <!-- warna normal -->
            <corners android:radius="10dp" />
            <padding
                android:top="5dp"
                android:bottom="5dp" />
            <stroke
                android:color="@color/coklatSikit"
                android:width="1dp" />
        </shape>
    </item>

</selector>
